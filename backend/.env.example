ENVIRONMENT=development
DATABASE_URL=mysql+asyncmy://recordshield:recordshield@localhost:3306/recordshield
SESSION_SECRET=replace-this-with-a-random-development-secret
M1_TEST_KEY=m1-development-only

# Mercy General mock EMR (separate process, private API). Both sides read these.
MERCY_EMR_URL=http://localhost:8001
MERCY_EMR_SERVICE_KEY=mercy-emr-dev-service-key
MERCY_EMR_DATABASE_URL=mysql+asyncmy://mercy_emr:mercy_emr@localhost:3306/mercy_emr

# Isolated audit process (separate process, owns the only SQLite file). Both sides read these.
AUDIT_SERVICE_URL=http://localhost:8002
AUDIT_SERVICE_KEY=audit-dev-service-key
AUDIT_DATABASE_PATH=audit.sqlite
